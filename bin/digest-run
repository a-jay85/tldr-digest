#!/bin/bash
# TLDR daily digest runner.
# Called by launchd at 07:00 weekdays. Only the scoring step uses an LLM;
# everything else is deterministic Python.
#
# To test manually: bin/digest-run
# To force-trigger via launchd: launchctl start com.tldr-digest.daily

set -euo pipefail

export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.local/bin:/Applications/cmux.app/Contents/Resources/bin:$PATH"

REPO="$(cd "$(dirname "$0")/.." && pwd)"
LOG_DIR="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-tldr-digest/digest/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/$(date +%Y-%m-%d).log"

cd "$REPO"

exec >> "$LOG" 2>&1

echo "=== Digest run starting at $(date) ==="

# Captured output of the most recent scoring attempt, scanned for usage-limit
# messages. Lives under the log dir so it's easy to inspect after a failure.
SCORE_OUT="$LOG_DIR/last_score_output.txt"

# One-shot launchd job used to re-run the digest once a usage limit resets.
RETRY_LABEL="com.tldr-digest.retry"
RETRY_PLIST="$HOME/Library/LaunchAgents/$RETRY_LABEL.plist"

# When this invocation *is* the scheduled retry, tear the one-shot job down on
# exit so it doesn't linger and fire again tomorrow at the same time. rm the
# plist first (so it can't reload), then bootout the in-memory job (this may
# SIGTERM us, but we're already exiting and the rm has landed).
if [ -n "${DIGEST_RETRY:-}" ]; then
    echo "(scheduled retry run — DIGEST_RETRY=1)"
    cleanup_retry_job() {
        rm -f "$RETRY_PLIST"
        launchctl bootout "gui/$(id -u)/$RETRY_LABEL" 2>/dev/null || true
    }
    trap cleanup_retry_job EXIT
fi

# Parse a usage-limit reset time out of the scoring output and schedule a
# one-shot launchd job to re-run the whole pipeline once the limit clears.
# launchd fires at the next occurrence of the given Hour:Minute (handling a
# reset that lands tomorrow) and runs on wake if the machine slept past it.
schedule_retry() {
    if [ -n "${DIGEST_RETRY:-}" ]; then
        echo "  already a retry run — not rescheduling; next daily run will retry" >&2
        return 1
    fi

    # Returns "<hour> <minute> <note>" in machine-local time, or non-zero on
    # an unparseable message (in which case we don't schedule).
    local parsed
    parsed=$(python3 - "$SCORE_OUT" <<'PY'
import re, sys, datetime
from zoneinfo import ZoneInfo

text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
m = re.search(r'resets\s+(\d{1,2})(?::(\d{2}))?\s*(am|pm)(?:\s*\(([^)]+)\))?', text, re.I)
if not m:
    sys.exit(1)

hh = int(m.group(1)); mm = int(m.group(2) or 0); ap = m.group(3).lower(); tzname = m.group(4)
if ap == "pm" and hh != 12: hh += 12
if ap == "am" and hh == 12: hh = 0

try:
    tz = ZoneInfo(tzname) if tzname else datetime.datetime.now().astimezone().tzinfo
except Exception:
    tz = datetime.datetime.now().astimezone().tzinfo

now = datetime.datetime.now(tz)
target = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
if target <= now:
    target += datetime.timedelta(days=1)
target += datetime.timedelta(minutes=2)  # small buffer past the reset
local = target.astimezone()
print(f"{local.hour} {local.minute} {local.strftime('%Y-%m-%d %H:%M %Z')}")
PY
) || { echo "  could not parse a reset time from scoring output — not scheduling a retry" >&2; return 1; }

    local hour minute note
    hour=$(echo "$parsed" | cut -d' ' -f1)
    minute=$(echo "$parsed" | cut -d' ' -f2)
    note=$(echo "$parsed" | cut -d' ' -f3-)

    cat > "$RETRY_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$RETRY_LABEL</string>
	<key>Program</key>
	<string>$REPO/bin/digest-run</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DIGEST_RETRY</key>
		<string>1</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>$hour</integer>
		<key>Minute</key>
		<integer>$minute</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>$REPO</string>
	<key>StandardOutPath</key>
	<string>$LOG_DIR/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>$LOG_DIR/launchd-stderr.log</string>
</dict>
</plist>
PLIST

    launchctl bootout "gui/$(id -u)/$RETRY_LABEL" 2>/dev/null || true
    if launchctl bootstrap "gui/$(id -u)" "$RETRY_PLIST"; then
        echo "  scheduled a one-shot retry for $note (launchd: $RETRY_LABEL)"
        return 0
    fi
    echo "  failed to load retry job via launchctl" >&2
    return 1
}

# --- Phase 1: Fetch, parse, sync (no LLM) ---

echo "[1/3] Fetching emails..."
python3 gmail_ops.py fetch

echo "[1/3] Parsing stories..."
python3 parse_tldr.py emails/ stories.json

echo "[1/3] Syncing feedback..."
python3 sync_feedback.py config.json feedback.json || echo "Warning: feedback sync failed, continuing with existing data"

echo "[1/3] Filtering seen stories..."
python3 filter_seen.py stories.json feedback.json stories_fresh.json

FRESH_COUNT=$(python3 -c "import json; print(len(json.load(open('stories_fresh.json'))))")
echo "  Fresh stories: $FRESH_COUNT"

if [ "$FRESH_COUNT" -eq 0 ]; then
    echo "No fresh stories today — skipping scoring and draft."
    echo "Archiving threads to keep inbox clean..."
    python3 gmail_ops.py archive
    echo "=== Digest run complete (no stories) at $(date) ==="
    exit 0
fi

# --- Phase 2: Score (LLM) ---

echo "[2/3] Scoring stories with LLM..."

PROMPT=$(python3 -c "
import json
from pathlib import Path
fb = json.load(open('feedback.json')).get('feedback', [])
if fb:
    votes = '\n'.join(f\"  {v['vote'].upper()}: {v['title']} ({v['source']})\" for v in fb)
else:
    votes = '  (none)'
template = Path('bin/digest-prompt').read_text()
print(template.replace('FEEDBACK_VOTES_PLACEHOLDER', votes))
")

# One scoring attempt: run the LLM under a wall-clock guard, then validate its
# output. An API/network stall on the scoring call can hang with no output
# indefinitely (it wedged ~3h on 2026-06-16). `timeout`/`gtimeout` aren't
# installed here, so use perl's alarm — the timer survives exec and SIGALRM's
# default disposition terminates claude. Returns non-zero on timeout, claude
# failure, or invalid output so the caller can retry.
score_once() {
    local rc=0
    # Drop any stale output from a previous attempt/day so validation can't
    # silently pass on it if the LLM writes nothing this time.
    rm -f scores.json

    # Capture claude's output so it can be scanned for a usage-limit message,
    # then mirror it to the log to preserve the previous live-logging behavior.
    perl -e 'alarm shift; exec @ARGV' 900 \
        claude -p "$PROMPT" \
        --allowedTools "Read,Write" \
        --dangerously-skip-permissions \
        --model sonnet \
        --max-turns 10 > "$SCORE_OUT" 2>&1 || rc=$?
    cat "$SCORE_OUT"

    # A usage/session limit won't clear within the retry loop's window, so don't
    # waste attempts on it — signal the caller (rc 2) to schedule a re-run at the
    # reset time instead.
    if grep -qiE "(session|usage) limit.*reset" "$SCORE_OUT"; then
        echo "  usage limit reached during scoring" >&2
        return 2
    fi

    if [ "$rc" -ne 0 ]; then
        if [ "$rc" -eq 142 ]; then
            echo "  scoring timed out after 15m" >&2
        else
            echo "  scoring failed (claude exit $rc)" >&2
        fi
        return 1
    fi

    # Validate the LLM's scores file, then deterministically merge the scores
    # back onto the full story records (joining on url_clean) to rebuild
    # scored_stories.json. The LLM only emits {url_clean, score, rationale},
    # keeping its streamed output small to reduce exposure to mid-response
    # connection drops; the heavy fields (description, urls) never round-trip.
    python3 -c "
import json, sys
try:
    scores = json.load(open('scores.json'))
    assert isinstance(scores, list), 'scores.json is not a list'
    fresh = {s['url_clean']: s for s in json.load(open('stories_fresh.json'))}
    merged = []
    for r in scores:
        for f in ('url_clean', 'score', 'rationale'):
            assert f in r, f'missing {f} in score entry: {r}'
        assert isinstance(r['score'], int), f'bad score type: {r}'
        story = fresh.get(r['url_clean'])
        assert story is not None, f'url_clean not in stories_fresh: {r[\"url_clean\"]}'
        merged.append({**story, 'score': r['score'], 'rationale': r['rationale']})
    merged.sort(key=lambda s: s['score'], reverse=True)
    json.dump(merged, open('scored_stories.json', 'w'), indent=2, ensure_ascii=False)
    print(f'Scoring validated: {len(merged)} stories')
except Exception as e:
    print(f'ERROR: scoring validation failed: {e}', file=sys.stderr)
    sys.exit(1)
"
}

# Retry the scoring step: transient API stalls/timeouts are the main failure
# mode here, so a couple of retries usually recover without manual intervention.
MAX_ATTEMPTS=3
SCORED_OK=0
for attempt in $(seq 1 "$MAX_ATTEMPTS"); do
    echo "  Scoring attempt $attempt/$MAX_ATTEMPTS..."
    score_once && { SCORED_OK=1; break; }
    rc=$?
    if [ "$rc" -eq 2 ]; then
        # Usage limit — schedule a re-run at the reset time and stop here. The
        # rescheduled run will redo the whole (idempotent) pipeline.
        if schedule_retry; then
            echo "=== Digest run deferred until usage limit resets at $(date) ==="
            exit 0
        fi
        echo "ERROR: usage limit hit and could not schedule a retry — aborting." >&2
        exit 1
    fi
    if [ "$attempt" -lt "$MAX_ATTEMPTS" ]; then
        echo "  Retrying in 30s..."
        sleep 30
    fi
done

if [ "$SCORED_OK" -ne 1 ]; then
    echo "ERROR: scoring failed after $MAX_ATTEMPTS attempts — aborting run, no draft created." >&2
    exit 1
fi

# --- Phase 3: Build, draft, archive, update (no LLM) ---

echo "[3/3] Building email..."
python3 build_email.py scored_stories.json config.json

echo "[3/3] Sending digest via Apps Script..."
python3 send_digest.py config.json

echo "[3/3] Archiving newsletter threads..."
python3 gmail_ops.py archive

echo "[3/3] Updating seen URLs..."
python3 update_seen.py scored_stories.json feedback.json

echo "[3/3] Committing and pushing..."
git add feedback.json
git commit -m "Update feedback.json with $(date +%Y-%m-%d) digest seen URLs" || true
git push || echo "Warning: git push failed"

# --- Summary ---

FOR_YOU=$(python3 -c "import json; s=json.load(open('scored_stories.json')); print(len([x for x in s if x['score']>=60]))")
ALSO=$(python3 -c "import json; s=json.load(open('scored_stories.json')); print(len([x for x in s if x['score']<60]))")
echo ""
echo "Summary: $FRESH_COUNT fresh stories → $((FOR_YOU + ALSO)) in digest ($FOR_YOU For You, $ALSO Also Today)"
echo "=== Digest run complete at $(date) ==="
